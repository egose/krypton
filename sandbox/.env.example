# ---------------------------------------------------------------------------
# Classification key (applies to every variable below):
#   required  — must be set explicitly; compose or provisioner fails closed when missing
#   optional  — may be omitted; documented default is used
#   local-only — host loopback publication for sandbox development; remove in production
#   unsafe default — sandbox value is checked in and must not be used in production
# ---------------------------------------------------------------------------
# Compose-side overrides only (auto-loaded from sandbox/.env).
# The app itself is configured via app/.env — copy sandbox/app.env.sandbox there.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Dex (sandbox OIDC provider)
# ---------------------------------------------------------------------------
# optional + local-only — host loopback publication for browser + host-run app.
# Coupled: must match `issuer` in dex/config.yaml AND the app's OIDC_ISSUER.
DEX_PORT=5556

# ---------------------------------------------------------------------------
# kind (local Kubernetes, managed by the root Makefile — not compose)
# ---------------------------------------------------------------------------
# optional — kind cluster name; kubecontext becomes kind-<name>
KIND_CLUSTER_NAME=krypton-sandbox
