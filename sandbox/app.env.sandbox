# Krypton app env for sandbox mode — copy to app/.env:
#   cp sandbox/app.env.sandbox app/.env
# Requires `make up` (kind + Dex + fixtures). All values are sandbox-only.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cluster scope over the two fixture namespaces (see kind/fixtures).
KRYPTON_SCOPE=cluster
KRYPTON_NAMESPACE=krypton-test
KRYPTON_NAMESPACES=krypton-test,frontend-ns
KRYPTON_HISTORY_LIMIT=20
KRYPTON_ETCD_ENCRYPTED=false
KRYPTON_IMPERSONATION=false
KRYPTON_ADMIN_GROUPS=krypton-admin
KRYPTON_ADMIN_USERS=
KRYPTON_ANNOTATION_PREFIX=krypton.io
KRYPTON_ACCESS_CONFIGMAP=krypton-access

# Real SSO against sandbox Dex (users: alice/bob/carol/admin, password `password`).
AUTH_DISABLED=false
SESSION_SECRET="sandbox-only-session-secret-32chars!!!" # pragma: allowlist secret
OIDC_ISSUER=http://localhost:5556/dex
OIDC_CLIENT_ID=krypton
OIDC_CLIENT_SECRET="krypton-sandbox-secret" # pragma: allowlist secret
OIDC_ALLOW_HTTP=true
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
OIDC_USERNAME_CLAIM=email
OIDC_NAME_CLAIM=name
SESSION_MAX_AGE=28800
