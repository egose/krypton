# --- Krypton local development -------------------------------------------
# The app talks to Kubernetes via ~/.kube/config when not running in-cluster.

# Public URL (used for OIDC redirect: <APP_URL>/api/auth/callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scope: namespace (default) reads POD_NAMESPACE only; cluster lists all namespaces
KRYPTON_SCOPE=namespace
KRYPTON_NAMESPACE=default
KRYPTON_NAMESPACES=
KRYPTON_HISTORY_LIMIT=20

# Set true once the cluster has etcd encryption-at-rest (aescbc) enabled,
# otherwise the UI shows a warning banner (secrets are only base64 in etcd).
KRYPTON_ETCD_ENCRYPTED=false

# K8s API impersonation (requires the API server to trust the same OIDC issuer).
# false = hybrid mode: app ServiceAccount executes, Krypton enforces authz itself.
KRYPTON_IMPERSONATION=false

# Bootstrap admins (SSO groups / emails). When BOTH are empty, every
# authenticated user is admin until you configure them.
KRYPTON_ADMIN_GROUPS=krypton-admin
KRYPTON_ADMIN_USERS=
KRYPTON_ANNOTATION_PREFIX=krypton.io
KRYPTON_ACCESS_CONFIGMAP=krypton-access

# --- Auth --------------------------------------------------------------------
# AUTH_DISABLED=true skips SSO with a mock admin (local dev only!)
AUTH_DISABLED=true
SESSION_SECRET=dev-only-insecure-secret-change-me-32chars!!

# Generic OIDC SSO (Keycloak / Entra ID / Okta / Google / GitHub)
OIDC_ISSUER=https://keycloak.example.com/realms/company
OIDC_CLIENT_ID=krypton
OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Allow http:// issuers (sandbox Dex on loopback). Refused for non-loopback
# issuers and when NODE_ENV=production.
OIDC_ALLOW_HTTP=false
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
OIDC_USERNAME_CLAIM=email
OIDC_NAME_CLAIM=name
SESSION_MAX_AGE=28800
